#!/usr/bin/env bash

# pdfcat: Render PDFs with ImageMagick and display them using imgcat.

usage() {
    cat <<'EOF'
Usage: pdfcat [OPTIONS] filename.pdf [filename2.pdf ...]

Display one or more PDFs in the terminal via ImageMagick + imgcat.

Each PDF page is displayed separately, at a readable terminal width.

Options:
  -H, --high-res    Render at 150 dpi and scale to full terminal width
  -1, --first-page  Display only the first page of each PDF
  -h, --help        Show this help message and exit
EOF
}

for COMMAND in magick imgcat mktemp; do
    if ! command -v "$COMMAND" >/dev/null 2>&1; then
        echo "Error: Required command '$COMMAND' not found in PATH." >&2
        exit 1
    fi
done

# Default rendering.
DENSITY=110
IMGCAT_OPTS=(-W '60%')
PAGE_SELECTOR=""
FILES=()
TMP_DIRS=()

cleanup() {
    ((${#TMP_DIRS[@]})) && rm -rf "${TMP_DIRS[@]}"
}

trap cleanup EXIT HUP INT TERM

while (($#)); do
    case "$1" in
        -H|--high-res)
            DENSITY=150
            IMGCAT_OPTS=(-W '100%')
            shift
            ;;
        -1|--first-page)
            # ImageMagick page indexes are zero-based: [0] means PDF page 1.
            PAGE_SELECTOR='[0]'
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Error: Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
        *)
            FILES+=("$1")
            shift
            ;;
    esac
done

# Arguments after -- are always filenames, including names beginning with '-'.
FILES+=("$@")

if ((${#FILES[@]} == 0)); then
    usage >&2
    exit 1
fi

for FILE in "${FILES[@]}"; do
    if [[ ! -f "$FILE" ]]; then
        echo "Error: File '$FILE' not found." >&2
        continue
    fi

    if ((${#FILES[@]} > 1)); then
        printf '\n%s\n' "$(basename "$FILE")" >&2
    fi

    # Render pages to separate JPEGs. Do not use -append: imgcat then scales
    # each page independently rather than shrinking a whole PDF into one image.
    TMP_DIR=$(mktemp -d -t pdfcat.XXXXXX)
    TMP_DIRS+=("$TMP_DIR")

    if ! magick -density "$DENSITY" "${FILE}${PAGE_SELECTOR}" \
        -background white \
        -alpha remove \
        "$TMP_DIR/page-%03d.jpg"
    then
        echo "Error: Could not render '$FILE'." >&2
        rm -rf "$TMP_DIR"
        continue
    fi

    PAGE_IMAGES=("$TMP_DIR"/page-*.jpg)

    if ((${#PAGE_IMAGES[@]} == 0)) || [[ ! -f "${PAGE_IMAGES[0]}" ]]; then
        echo "Error: No pages were rendered from '$FILE'." >&2
        continue
    fi

    for PAGE_IMAGE in "${PAGE_IMAGES[@]}"; do
        imgcat "${IMGCAT_OPTS[@]}" "$PAGE_IMAGE"
    done
done

#!/usr/bin/env bash

# pdfcat: Wrapper for imgcat to correctly display PDFs on dark terminals

usage() {
    cat <<'EOF'
Usage: pdfcat [OPTIONS] filename.pdf [filename2.pdf ...]

Display one or more PDFs in the terminal via ImageMagick + imgcat.

Options:
  -H, --high-res  Render at 150dpi and scale to fit terminal width
  -h, --help      Show this help message and exit
EOF
}

# Check dependencies
if ! command -v magick &> /dev/null; then
    echo "Error: ImageMagick (magick) command not found." >&2
    exit 1
fi

if ! command -v imgcat &> /dev/null; then
    echo "Error: 'imgcat' script not found in PATH." >&2
    exit 1
fi

# Default settings
DENSITY=72
IMGCAT_OPTS=""

# Parse arguments
FILES=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -H|--high-res)
            DENSITY=150
            IMGCAT_OPTS="-W 100%"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Error: Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
        *)
            FILES+=("$1")
            shift
            ;;
    esac
done

# Any remaining args after --
while [[ $# -gt 0 ]]; do
    FILES+=("$1")
    shift
done

if [ ${#FILES[@]} -eq 0 ]; then
    usage >&2
    exit 1
fi

# Process each file
for FILE in "${FILES[@]}"; do
    if [ ! -f "$FILE" ]; then
        echo "Error: File '$FILE' not found." >&2
        continue
    fi

    # ImageMagick v7 command:
    # -density:      Must come BEFORE the filename to affect PDF reading resolution.
    # -background:   Sets the matte color (white) for transparency replacement.
    # -alpha remove: Replaces transparency with the background color.
    # -append:       Stitches multiple PDF pages vertically into one long image.
    # jpg:-:         Streams the output as JPEG (solid background) to stdout.

    magick -density "$DENSITY" "$FILE" \
           -background white \
           -alpha remove \
           -append \
           jpg:- | imgcat $IMGCAT_OPTS
done

